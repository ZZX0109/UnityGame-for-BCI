# Text assets use LF so source/font provenance hashes match every checkout.
* text=auto eol=lf
*.png binary
*.jpg binary
*.fbx binary
*.dll binary
*.exe binary
*.otf binary
*.ttf binary
*.ttc binary

# Keep compiler/Editor evidence bytes and diagnostic spacing exactly as emitted.
Validation/Evidence-*/**/*.log -text -whitespace

# Preserve exact bytes of the renderer regressions already bound to the final native fingerprint.
Assets/StreetCrossing/Tests/EditMode/StreetMaterialPersistenceTests.cs -text
Assets/StreetCrossing/Tests/PlayMode/ShopSignVisibilityTests.cs -text
